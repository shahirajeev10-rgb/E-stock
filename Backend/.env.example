NODE_ENV=development
PORT=3002
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=replace-with-long-random-secret-at-least-16-chars
SESSION_TTL_DAYS=7
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
PASSWORD_RESET_MODE=smtp
PASSWORD_RESET_URL=http://localhost:3000/forgot-password
APP_NAME=eStock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="eStock <no-reply@example.com>"

# Production example values:
# NODE_ENV=production
# CLIENT_URL=https://your-app.vercel.app
# CLIENT_URLS=https://your-app.vercel.app,https://www.yourdomain.com
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# PASSWORD_RESET_URL=https://your-app.vercel.app/forgot-password
